---
import Layout from '../layouts/Layout.astro'
import GigItem from '../components/GigItem.vue'
import gigsData from '../data/gigs'

const upcomingGigs = gigsData.filter((gig) => gig.status === 'upcoming')
const pastGigs = gigsData.filter((gig) => gig.status === 'past')

const siteUrl = Astro.site ? Astro.site.origin : 'https://blue-cherry-cookie.web.app'

const gigsStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'BLUE CHERRY COOKIE 공연 일정',
  description: '블루체리쿠키의 공연 일정 목록입니다.',
  itemListElement: gigsData.map((gig, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'MusicEvent',
      name: gig.title || 'BLUE CHERRY COOKIE 공연',
      startDate: gig.date,
      eventStatus:
        gig.status === 'upcoming'
          ? 'https://schema.org/EventScheduled'
          : 'https://schema.org/EventCompleted',
      location: {
        '@type': 'Place',
        name: gig.location,
        address: {
          '@type': 'PostalAddress',
          addressLocality: gig.location,
        },
      },
      performer: {
        '@type': 'MusicGroup',
        name: 'BLUE CHERRY COOKIE',
        alternateName: '블루체리쿠키',
        url: `${siteUrl}/`,
      },
    },
  })),
}
---

<Layout
  title="공연 | BLUE CHERRY COOKIE"
  description="블루체리쿠키의 공연 일정 및 지난 공연 기록입니다."
  keywords={['BLUE CHERRY COOKIE 공연', '블루체리쿠키 공연', '공연 일정', '콘서트']}
  jsonLd={gigsStructuredData}
>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="border-brand-accent mb-12 border-l-8 pl-6 text-4xl font-black">공연</h1>

    <section class="mb-20">
      <h2 class="text-brand-cookie mb-8 text-2xl font-bold">다가오는 공연</h2>
      <div class="space-y-6">
        {
          upcomingGigs.length > 0 ? (
            upcomingGigs.map((gig) => (
              <div>
                <GigItem gig={gig} client:load />
              </div>
            ))
          ) : (
            <p class="text-gray-500 italic">진행 예정인 공연이 없습니다.</p>
          )
        }
      </div>
    </section>

    <section>
      <h2 class="text-brand-grey mb-8 text-2xl font-bold">지난 공연</h2>
      <div class="space-y-6 opacity-80">
        {
          pastGigs.length > 0 ? (
            pastGigs.map((gig) => (
              <div>
                <GigItem gig={gig} client:load />
              </div>
            ))
          ) : (
            <p class="text-gray-500 italic">지난 공연 기록이 없습니다.</p>
          )
        }
      </div>
    </section>
  </div>
</Layout>
