---
import Layout from '../layouts/Layout.astro';
import SocialLink from '../components/SocialLink.vue';
import BlueCherryCookieLogo from '../assets/blue-cherry-cookie-logo.png';
---

<Layout title="BLUE CHERRY COOKIE - Home">
	<section class="max-w-6xl mx-auto px-4 py-20 flex flex-col items-center text-center">
		<div class="mb-12">
			<img
				src={BlueCherryCookieLogo.src}
				alt="Blue Cherry Cookie Logo"
				class="w-64 md:w-80 h-auto rounded-lg shadow-2xl"
			/>
		</div>

		<p class="text-xl md:text-2xl text-gray-300 max-w-2xl mb-12 leading-relaxed">
			나의 마음이 너의 울림이 될 때 <br/>
			見つけたよ、蒼のハーモニー
		</p>

		<div class="flex flex-wrap justify-center gap-6">
			<SocialLink platform="YouTube" url="https://youtube.com/@bluecherrycookie" client:load />
			<SocialLink platform="Instagram" url="https://instagram.com/bluecherrycookie_band" client:load />
		</div>
	</section>
</Layout>
