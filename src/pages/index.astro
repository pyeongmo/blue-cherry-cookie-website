---
import Layout from '../layouts/Layout.astro'
import SocialLink from '../components/SocialLink.vue'
import BlueCherryCookieLogo from '../assets/blue-cherry-cookie-logo.png'
import gigsData from '../data/gigs.json'

const firstUpcomingGig = gigsData.find((gig) => gig.status === 'upcoming')
const posterModules = import.meta.glob('../assets/gigs/**/*.{jpg,jpeg,png,webp,svg}', {
  eager: true,
})

const getPosterUrl = (path: string) => {
  const image = posterModules[path.replace('/src/assets/', '../assets/')]
  if (!image) return undefined

  const importedImage = image as { default?: string | { src?: string } }
  return typeof importedImage.default === 'string'
    ? importedImage.default
    : importedImage.default?.src
}

const firstPoster = firstUpcomingGig?.posters?.[0]
  ? getPosterUrl(firstUpcomingGig.posters[0])
  : undefined
const firstUpcomingTitle = firstUpcomingGig?.title || '제목 미정'
const firstUpcomingTime = firstUpcomingGig?.time || '시간 미정'
---

<Layout title="BLUE CHERRY COOKIE - Home">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-20 text-center">
    <div class="mb-12">
      <img
        src={BlueCherryCookieLogo.src}
        alt="Blue Cherry Cookie Logo"
        class="h-auto w-64 rounded-lg shadow-2xl md:w-80"
      />
    </div>

    <p class="mb-12 max-w-2xl text-xl leading-relaxed text-gray-300 md:text-2xl">
      나의 마음이 너의 울림이 될 때 <br />
      見つけたよ、蒼のハーモニー
    </p>

    <div class="flex flex-wrap justify-center gap-6">
      <SocialLink platform="YouTube" url="https://youtube.com/@bluecherrycookie" client:load />
      <SocialLink
        platform="Instagram"
        url="https://instagram.com/bluecherrycookie_band"
        client:load
      />
    </div>

    {
      firstUpcomingGig && (
        <section class="mt-20 w-full max-w-sm text-left" aria-labelledby="next-gig-title">
          <p class="text-brand-cookie mb-4 text-sm font-bold tracking-widest">다가오는 공연</p>
          <a
            href="/gigs"
            class="group border-brand-grey hover:border-brand-accent focus-visible:outline-brand-cookie block rounded-lg border bg-black p-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {firstPoster ? (
              <img
                src={firstPoster}
                alt={`${firstUpcomingTitle} 포스터`}
                class="aspect-3/4 w-full rounded-md object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
            ) : (
              <div class="border-brand-grey flex aspect-3/4 items-center justify-center rounded-md border border-dashed text-gray-500">
                포스터 미정
              </div>
            )}
            <div class="px-2 pt-4 pb-2">
              <h2 id="next-gig-title" class="text-2xl font-bold">
                {firstUpcomingTitle}
              </h2>
              <p class="mt-2 text-gray-400">
                {firstUpcomingGig.date} · {firstUpcomingTime}
              </p>
            </div>
          </a>
        </section>
      )
    }
  </section>
</Layout>
