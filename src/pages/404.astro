---
import Layout from '../layouts/Layout.astro'
import logoIcon from '../assets/blue-cherry-cookie-icon.png'
---

<Layout title="404 - BLUE CHERRY COOKIE">
  <section
    class="relative isolate flex min-h-[calc(100vh-166px)] items-center justify-center overflow-hidden px-4 py-20"
  >
    <div
      aria-hidden="true"
      class="bg-brand-accent/20 absolute top-1/2 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
    >
    </div>

    <div class="mx-auto w-full max-w-3xl text-center">
      <div class="text-brand-cookie mb-8 flex items-center justify-center gap-4">
        <span class="bg-brand-cookie/60 h-px w-12"></span>
        <span class="font-mono text-xs tracking-[0.35em]">SIGNAL LOST</span>
        <span class="bg-brand-cookie/60 h-px w-12"></span>
      </div>
      <p aria-hidden="true" class="font-headline text-2xl text-white/50">404</p>

      <div class="relative mx-auto w-fit py-8">
        <img src={logoIcon.src} alt="" width="120px" class="mx-auto" />
      </div>

      <h1 class="mb-12 text-4xl font-bold md:text-5xl">페이지를 찾을 수 없습니다</h1>

      <a
        href="/"
        class="bg-brand-accent focus-visible:outline-brand-cookie inline-flex items-center gap-3 rounded-full px-6 py-3 font-bold transition-transform hover:scale-105 hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        <span aria-hidden="true">←</span>
        홈으로 돌아가기
      </a>
    </div>
  </section>
</Layout>
