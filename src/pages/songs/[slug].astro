---
import Layout from '../../layouts/Layout.astro'
import SongDetailSoundCheck from '../../components/SongDetailSoundCheck.vue'
import SongDetailLine from '../../components/SongDetailLine.vue'
import songsData from '../../data/songs.json'

export function getStaticPaths() {
  return songsData.map((song) => ({ params: { slug: song.slug }, props: { song } }))
}

const { song } = Astro.props
---

<Layout title={`${song.title} - BLUE CHERRY COOKIE`}>
  {
    song.slug === 'sound-check' ? (
      <SongDetailSoundCheck song={song} />
    ) : (
      <SongDetailLine song={song} />
    )
  }
</Layout>
