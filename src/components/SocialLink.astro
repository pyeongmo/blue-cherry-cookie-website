---
import youtubeIcon from '../assets/icon-youtube.svg'
import instagramIcon from '../assets/icon-instagram.svg'

interface Props {
  platform: 'YouTube' | 'Instagram'
  url: string
}

const { platform, url } = Astro.props

const icons = {
  YouTube: youtubeIcon.src,
  Instagram: instagramIcon.src,
}

const getPlatformColor = (platform: string) => {
  if (platform.toLowerCase() === 'youtube') return 'hover:bg-red-600'
  if (platform.toLowerCase() === 'instagram') return 'hover:bg-pink-600'
  return 'hover:bg-brand-accent'
}
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'group inline-flex transform items-center rounded-full px-6 py-3 text-lg font-bold transition-all duration-300 hover:scale-105',
    getPlatformColor(platform),
  ]}
>
  {
    platform ? (
      <img
        src={icons[platform]}
        alt={platform}
        class="mr-3 h-6 w-6 brightness-0 invert filter transition-all"
      />
    ) : (
      <span class="mr-2">🔗</span>
    )
  }
  {platform}
</a>
