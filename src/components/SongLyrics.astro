---
import type { LyricGroup } from '../data/lyrics'

interface Props {
  lyricGroups: LyricGroup[]
}

const { lyricGroups } = Astro.props
---

<section class="lyrics">
  <h2>LYRICS</h2>
  {
    lyricGroups.map((group) => (
      <div class="lyric-group">
        {group.lyrics.map((lyric) =>
          typeof lyric === 'string' ? (
            <p class="original">{lyric}</p>
          ) : (
            <>
              <p class="original">{lyric.original}</p>
              <p class="translation">{lyric.translation}</p>
            </>
          ),
        )}
      </div>
    ))
  }
</section>

<style>
  .lyrics {
    border-top: 1px solid #333;
    margin-top: 7rem;
    padding-top: 3rem;
    text-align: center;
  }
  .lyrics h2 {
    color: var(--accent);
    font:
      2rem 'Bebas Neue',
      sans-serif;
    letter-spacing: 0.2em;
  }
  .lyric-group {
    max-width: 42rem;
    margin: 3rem auto 0;
  }
  .lyric-group + .lyric-group {
    margin-top: 4rem;
  }
  .original,
  .translation {
    white-space: pre-wrap;
    line-height: 2;
    font-size: 1.1rem;
    margin: 0;
  }
  .translation {
    margin-top: 0.35rem;
    color: var(--accent);
    font-size: 0.95rem;
    font-style: italic;
  }
</style>
